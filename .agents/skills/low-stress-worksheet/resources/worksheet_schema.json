{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LowStressWorksheetSchema",
  "type": "object",
  "required": [
    "worksheet_title",
    "standard_code",
    "target_whitespace_ratio",
    "problems"
  ],
  "properties": {
    "worksheet_title": {
      "type": "string",
      "description": "Clear, concise title of the worksheet."
    },
    "standard_code": {
      "type": "string",
      "description": "Educational standard alignment tag, e.g. 'HS-PS2-1' or 'HS-ESS1-5'."
    },
    "target_whitespace_ratio": {
      "type": "number",
      "description": "Target proportion of open page area (0.30 to 0.40).",
      "minimum": 0.3,
      "maximum": 0.4
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "problem_number",
          "keep_together_atomic",
          "is_worked_pair",
          "stimulus",
          "sub_prompts",
          "estimated_total_height_in"
        ],
        "properties": {
          "problem_number": {
            "type": "integer"
          },
          "keep_together_atomic": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "is_worked_pair": {
            "type": "boolean"
          },
          "stimulus": {
            "type": "object",
            "required": [
              "context_line",
              "extracted_givens",
              "diagram_spec"
            ],
            "properties": {
              "context_line": {
                "type": "string"
              },
              "extracted_givens": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "diagram_spec": {
                "type": "object",
                "required": [
                  "needed",
                  "description",
                  "embedded_labels"
                ],
                "properties": {
                  "needed": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string"
                  },
                  "embedded_labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "sub_prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "part_label",
                "command_verb",
                "prompt_text",
                "teacher_solution_steps",
                "step_count",
                "workspace"
              ],
              "properties": {
                "part_label": {
                  "type": "string"
                },
                "command_verb": {
                  "type": "string",
                  "enum": [
                    "Sketch",
                    "Calculate",
                    "Derive",
                    "Justify",
                    "Predict",
                    "Compare",
                    "Identify",
                    "Plot"
                  ]
                },
                "prompt_text": {
                  "type": "string"
                },
                "teacher_solution_steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "step_count": {
                  "type": "integer"
                },
                "workspace": {
                  "type": "object",
                  "required": [
                    "archetype",
                    "height_in",
                    "ruled_line_count",
                    "zones",
                    "answer_unit_prompt"
                  ],
                  "properties": {
                    "archetype": {
                      "type": "string",
                      "enum": [
                        "zoned_calculation",
                        "dot_grid_canvas",
                        "ruled_prose",
                        "claim_evidence_reasoning",
                        "short_value_box"
                      ]
                    },
                    "height_in": {
                      "type": "number"
                    },
                    "ruled_line_count": {
                      "type": "integer"
                    },
                    "zones": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "zone_header",
                          "width_pct",
                          "surface_pattern",
                          "faded_scaffold_hint"
                        ],
                        "properties": {
                          "zone_header": {
                            "type": "string"
                          },
                          "width_pct": {
                            "type": "integer",
                            "minimum": 15,
                            "maximum": 100
                          },
                          "surface_pattern": {
                            "type": "string",
                            "enum": [
                              "dot_grid",
                              "blank_open",
                              "ruled_lines",
                              "pre_drawn_axes"
                            ]
                          },
                          "faded_scaffold_hint": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "answer_unit_prompt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "estimated_total_height_in": {
            "type": "number"
          }
        }
      }
    }
  }
}