{
  "worksheet_title": "Newton's Second Law & Friction: Guided Practice",
  "header_reference_bank": {
    "equations": [
      "F_net = m · a",
      "F_friction = μ · F_N",
      "F_g = m · g"
    ],
    "constants": [
      "g = 9.8 m/s²",
      "1 N = 1 kg·m/s²"
    ]
  },
  "problems": [
    {
      "problem_number": 1,
      "is_worked_pair": true,
      "keep_together_atomic": true,
      "estimated_total_height_in": 7.2,
      "stimulus": {
        "context_line": "A 4.0 kg cart is pulled across a smooth laboratory track by a horizontal tension cable. Friction between the cart wheels and track is *negligibly small*.",
        "extracted_givens": [
          "Mass (m) = 4.0 kg",
          "Horizontal Tension (F_T) = 12.0 N",
          "Friction force (F_f) = 0 N"
        ],
        "diagram_spec": {
          "needed": true,
          "description": "Cart on horizontal track pulled to the right by tension F_T with vertical normal force F_N and gravity F_g balanced.",
          "embedded_labels": ["F_N (up)", "F_g = 39.2 N (down)", "F_T = 12.0 N (right)"]
        }
      },
      "sub_prompts": [
        {
          "part_label": "a",
          "command_verb": "Draw",
          "prompt_text": "Construct a labeled free-body diagram for the 4.0 kg cart *while accelerating horizontally*.",
          "step_count": 2,
          "teacher_solution_steps": [
            "Draw upward normal force arrow F_N and downward gravity arrow F_g equal in length.",
            "Draw rightward horizontal tension arrow F_T = 12.0 N with no opposing friction arrow."
          ],
          "workspace": {
            "height_in": 1.75,
            "ruled_line_count": 0,
            "answer_unit_prompt": "",
            "zones": [
              {
                "surface_pattern": "dot_grid",
                "width_pct": 100,
                "zone_header": "Free-Body Diagram Canvas (1 grid unit = 4 N)",
                "faded_scaffold_hint": "• Cart Center (start arrows from center dot)"
              }
            ]
          }
        },
        {
          "part_label": "b",
          "command_verb": "Calculate",
          "prompt_text": "Determine the horizontal acceleration of the cart *assuming zero friction*.",
          "step_count": 3,
          "teacher_solution_steps": [
            "Identify F_net = F_T = 12.0 N.",
            "Rearrange formula: a = F_net / m.",
            "Substitute values: a = 12.0 N / 4.0 kg = 3.0 m/s²."
          ],
          "workspace": {
            "height_in": 1.5,
            "ruled_line_count": 0,
            "answer_unit_prompt": "[ m/s² ]",
            "zones": [
              {
                "surface_pattern": "blank_open",
                "width_pct": 35,
                "zone_header": "1. Symbolic Setup",
                "faded_scaffold_hint": "a = F_net / m"
              },
              {
                "surface_pattern": "blank_open",
                "width_pct": 65,
                "zone_header": "2. Substitution & Evaluation",
                "faded_scaffold_hint": "a = ( 12.0 N ) / ( 4.0 kg ) = "
              }
            ]
          }
        }
      ]
    },
    {
      "problem_number": 2,
      "is_worked_pair": false,
      "keep_together_atomic": true,
      "estimated_total_height_in": 7.5,
      "stimulus": {
        "context_line": "A student pushes an 8.0 kg wooden crate across a rough linoleum floor with a steady horizontal force of 38.0 N. Kinetic friction opposes the motion.",
        "extracted_givens": [
          "Mass (m) = 8.0 kg",
          "Applied Force (F_app) = 38.0 N (right)",
          "Friction Force (F_f) = 14.0 N (left)"
        ],
        "diagram_spec": {
          "needed": true,
          "description": "Crate on floor with forward applied push and backward opposing friction.",
          "embedded_labels": ["F_app = 38.0 N", "F_f = 14.0 N", "m = 8.0 kg"]
        }
      },
      "sub_prompts": [
        {
          "part_label": "a",
          "command_verb": "Calculate",
          "prompt_text": "Determine the net horizontal force (F_net) acting on the crate *in the direction of motion*.",
          "step_count": 2,
          "teacher_solution_steps": [
            "F_net = F_app − F_f",
            "F_net = 38.0 N − 14.0 N = 24.0 N"
          ],
          "workspace": {
            "height_in": 1.25,
            "ruled_line_count": 0,
            "answer_unit_prompt": "[ N ]",
            "zones": [
              {
                "surface_pattern": "blank_open",
                "width_pct": 40,
                "zone_header": "1. Vector Sum Setup",
                "faded_scaffold_hint": ""
              },
              {
                "surface_pattern": "blank_open",
                "width_pct": 60,
                "zone_header": "2. Calculation",
                "faded_scaffold_hint": ""
              }
            ]
          }
        },
        {
          "part_label": "b",
          "command_verb": "Calculate",
          "prompt_text": "Calculate the resulting horizontal acceleration of the crate *while the push is applied*.",
          "step_count": 3,
          "teacher_solution_steps": [
            "Use Newton's 2nd Law: a = F_net / m",
            "Substitute: a = 24.0 N / 8.0 kg",
            "Evaluate: a = 3.0 m/s²"
          ],
          "workspace": {
            "height_in": 1.5,
            "ruled_line_count": 0,
            "answer_unit_prompt": "[ m/s² ]",
            "zones": [
              {
                "surface_pattern": "blank_open",
                "width_pct": 35,
                "zone_header": "1. Symbolic Formula",
                "faded_scaffold_hint": ""
              },
              {
                "surface_pattern": "blank_open",
                "width_pct": 65,
                "zone_header": "2. Value Substitution & Answer",
                "faded_scaffold_hint": ""
              }
            ]
          }
        },
        {
          "part_label": "c",
          "command_verb": "Explain",
          "prompt_text": "Explain what happens to the crate's acceleration if the student *doubles the applied push to 76.0 N* while friction remains 14.0 N.",
          "step_count": 3,
          "teacher_solution_steps": [
            "State new net force: F_net = 76 N − 14 N = 62 N.",
            "Note that F_net more than doubles (from 24 N to 62 N, a 2.58x increase).",
            "Conclude that acceleration increases by more than double (a = 62 / 8 = 7.75 m/s²)."
          ],
          "workspace": {
            "height_in": 1.35,
            "ruled_line_count": 3,
            "answer_unit_prompt": "",
            "zones": [
              {
                "surface_pattern": "ruled_lines",
                "width_pct": 100,
                "zone_header": "Scientific Explanation (Claim & Evidence)",
                "faded_scaffold_hint": ""
              }
            ]
          }
        }
      ]
    }
  ]
